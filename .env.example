# Copy this file to .env (already gitignored) and fill in real values.
# Docker Compose loads .env automatically from the same directory as
# docker-compose.yml. Leave any of these blank/unset to keep single
# sign-on disabled and use local email/password accounts only.
# See docs/auth.md and docs/installation.md#optional-single-sign-on-oidc.

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
